# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Avoid Xcode skipping Pods script phases / failing to produce Pods_Runner.framework.
install! 'cocoapods', :disable_input_output_paths => true

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      config.build_settings['DEFINES_MODULE'] = 'YES'
      # Xcode 26 explicit modules cannot resolve CocoaPods Swift plugin modules
      # such as path_provider_foundation from GeneratedPluginRegistrant.m.
      config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
      config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
    end
  end
end

# Xcode 26 may not implicitly build Pods-Runner, which then fails with
# "Framework 'Pods_Runner' not found". Add an explicit target dependency so
# the umbrella framework is produced before linking. Keep Pods products in a
# separate group so Runner's Products group is not overwritten.
post_integrate do |installer|
  installer.aggregate_targets.each do |aggregate_target|
    user_project = aggregate_target.user_project
    runner_target = user_project.targets.find { |t| t.name == 'Runner' }
    pods_runner = installer.pods_project.targets.find { |t| t.name == 'Pods-Runner' }
    next if runner_target.nil? || pods_runner.nil?

    unless runner_target.dependencies.any? { |d| d.name == 'Pods-Runner' }
      runner_target.add_dependency(pods_runner)
    end

    runner_products = user_project.products_group
    user_project.root_object.project_references.each do |ref|
      product_group = ref[:product_group] || ref['ProductGroup']
      next if product_group.nil? || runner_products.nil?
      next unless product_group.uuid == runner_products.uuid

      pods_products = user_project.main_group.groups.find { |g| g.name == 'Pods Products' }
      pods_products ||= user_project.new_group('Pods Products')
      runner_products.children.select { |child| child.isa == 'PBXReferenceProxy' }.each do |child|
        runner_products.children.delete(child)
        pods_products.children << child unless pods_products.children.include?(child)
      end
      if ref.key?(:product_group)
        ref[:product_group] = pods_products
      else
        ref['ProductGroup'] = pods_products
      end
    end

    user_project.save
  end
end
